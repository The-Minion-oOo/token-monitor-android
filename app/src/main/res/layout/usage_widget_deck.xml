<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/swipe_page_bitmap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:importantForAccessibility="yes"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/swipe_page_open"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/app_name" />

    <TextView
        android:id="@+id/swipe_page_previous"
        android:layout_width="48dp"
        android:layout_height="96dp"
        android:layout_gravity="start|center_vertical"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/swipe_page_next"
        android:layout_width="48dp"
        android:layout_height="96dp"
        android:layout_gravity="end|center_vertical"
        android:background="@android:color/transparent" />

    <!-- Weights are card units from WidgetDeckGrid.Header: 0 … 188 open, Refresh 188 … 276, Live 276 … 364. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="188"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="88"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/widget_live"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="88"
            android:background="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>
